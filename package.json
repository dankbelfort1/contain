{
  "name": "contain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "description": "Secret-leak remediation agent. The agent earns information, not permissions.",
  "scripts": {
    "setup": "node scripts/install-gitleaks.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/install-gitleaks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx src/fixtures/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "contain": "tsx src/cli/main.ts",
    "demo": "tsx src/cli/main.ts run fixtures/leaky-service",
    "demo:dry": "tsx src/cli/main.ts run fixtures/leaky-service --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
