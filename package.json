{
  "name": "contain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "description": "Secret-leak remediation agent. The agent earns information, not permissions.",
  "scripts": {
    "setup": "node scripts/install-gitleaks.mjs && node scripts/patch-kysely-windows.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/install-gitleaks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx src/fixtures/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "contain": "tsx src/cli/main.ts",
    "demo": "tsx src/cli/main.ts run fixtures/leaky-service",
    "demo:dry": "tsx src/cli/main.ts run fixtures/leaky-service --dry-run",
    "ui": "tsx src/server/main.ts fixtures/leaky-service",
    "ui:dry": "tsx src/server/main.ts fixtures/leaky-service --dry-run",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "trueforge": "node node_modules/@truefoundry/trueforge/dist/cli.js",
    "trueforge:agent": "node scripts/create-trueforge-agent.mjs",
    "trueforge:demo": "node scripts/run-trueforge-demo.mjs",
    "postinstall": "node scripts/patch-kysely-windows.mjs",
    "screens": "node scripts/capture-ui-screens.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "^0.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
