# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- TrueForge (the agent harness) ---
TRUEFORGE_BASE_URL=http://localhost:8790

# --- Model provider ---
# Google Gemini. Free tier, no card required, no billing setup.
# TrueForge ships `google-gemini` as a catalog provider.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Sandbox provider ---
# Daytona. Ships with $200 free compute; a verification sandbox
# runs for seconds and costs a fraction of a cent.
DAYTONA_API_KEY=

# --- Demo fixtures. THROWAWAY GitHub account only. ---
# Revocation is irreversible and notifies the token owner.
FIXTURE_LIVE_GITHUB_PAT=
FIXTURE_DEAD_GITHUB_PAT=
